<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="page">
    <section class="card">
      <header class="brand">
        <div class="logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h9l4 4v14H6z"/>
            <path d="M15 3v4h4"/>
            <path d="M9 12h7M9 16h7"/>
          </svg>
        </div>
        <h1>Welcome back</h1>
        <p class="tagline">Log in to access your notes.</p>
      </header>
      <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-error" role="alert">
          <ul>
            <% errors.forEach(function (error) { %>
              <li><%= typeof error === 'string' ? error : error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/login" method="POST" novalidate>
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="login" autocomplete="username" placeholder="Your username"
                 value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password"
                 placeholder="Your password" required>
        </div>

        <button type="submit" class="btn">Log in</button>
      </form>

      <p class="switch">New here? <a href="/register">Create an account</a></p>
    </section>
  </main>
</body>
</html>
